<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app window: Lantern's background from launch, not the manufacturer's default colour. -->
    <style name="Theme.Lantern" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/lantern_background</item>
        <item name="android:windowSplashScreenBackground">@color/lantern_background</item>
    </style>
    <style name="Theme.Lantern.Challenge" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
